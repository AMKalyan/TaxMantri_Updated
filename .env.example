# TaxMantri backend environment configuration
# Copy this file to .env and fill in real values:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env  (Windows)

# --- PostgreSQL connection ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Use the asyncpg driver (not psycopg2); async SQLAlchemy needs it
DATABASE_URL=postgresql+asyncpg://taxmantri:taxmantri@localhost:5432/taxmantri

# --- Redis connection ---
REDIS_URL=redis://localhost:6379

# --- JWT signing secret ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters in production
SECRET_KEY=change-me-in-production-at-least-32-chars

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- CORS allowed frontend origins ---
# Comma-separated list — add deployed frontend URL for production
# Example for production: CORS_ORIGINS=http://localhost:5173,https://taxmantri.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Debug mode ---
# true  → include exception details in error responses (dev only)
# false → generic 500 message; full traceback logged server-side only
DEBUG=false

# --- Application version (auto-set, no need to change) ---
APP_VERSION=0.2.0

# --- OCR binaries (optional; leave blank to use PATH — Docker image has both) ---
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
POPPLER_PATH=

# --- Abuse protection & retention ---
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_MB=5
DATA_RETENTION_HOURS=24
TRUSTED_PROXY_HOPS=1
LLM_DAILY_CAP=150
